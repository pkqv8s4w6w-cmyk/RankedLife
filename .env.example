# ---------------------------------------------------------------------------
# All of this is optional. With an empty .env the app still runs, stores
# everything in your browser, and works offline. These only add cross-device
# sync and the natural-language entry box.
# ---------------------------------------------------------------------------

# Shared secret for /api/sync, /api/gate and /api/parse. If it is unset the
# endpoints are open, which is fine on your own laptop and NOT fine on a public
# deploy. Set it to anything long and paste the same value into the app's
# Settings > Sync, and into the browser extension's options.
RANKEDLIFE_KEY=

# --- Cross-device sync: pick ONE (or neither) ------------------------------
# Any Postgres connection string. Neon and Supabase both have free tiers.
# The table is created on first use.
DATABASE_URL=

# Or Upstash Redis over REST. No driver needed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Natural-language entry ------------------------------------------------
# 'anthropic' (default) or 'deepseek' / 'openai' for any OpenAI-compatible API.
RL_AI_PROVIDER=anthropic

# For the Anthropic path. Haiku 4.5 is the default model: this is a short
# extraction that runs every time you log a day, so it does not need a big one.
ANTHROPIC_API_KEY=

# For the OpenAI-compatible path.
RL_AI_API_KEY=
RL_AI_BASE_URL=https://api.deepseek.com/v1

# Override the model on either path.
# RL_AI_MODEL=claude-haiku-4-5
