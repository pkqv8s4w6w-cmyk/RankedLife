{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": []
  },
  "include": ["src/lib/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "src/lib/store.tsx", "src/lib/server/**"]
}
